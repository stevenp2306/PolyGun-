# =============================================================================
# polybot configuration - copy to `.env` and edit.   cp .env.example .env
#
# * NO real secrets belong in this file. Put secrets in secrets/polybot.env by
#   running `polybot setup-credentials` (hidden input, file mode 600), or in
#   your server's secret store.
# * Every number below is an UNVALIDATED RESEARCH ASSUMPTION / example, not
#   financial advice and not a proven profitable setting.
# * Money amounts are in USDC (Polymarket's collateral, ~1 US dollar).
# =============================================================================

# ---------------------------------------------------------------- general
# paper = simulated orders on real market data (DEFAULT). live = real orders,
# and only after the live checklist (docs/LIVE_TRADING.md) is complete.
POLYBOT_MODE=paper
# Where trades, orders and decisions are stored. SQLite file by default.
# PostgreSQL: postgresql+psycopg://user:pass@host:5432/polybot (pip install ".[postgres]")
POLYBOT_DATABASE_URL=sqlite:///data/polybot.db
POLYBOT_DATA_DIR=data
POLYBOT_LOG_DIR=logs
POLYBOT_LOG_LEVEL=INFO
# Seconds between decision loops (the bot is awake 24/7; it does not trade every loop).
POLYBOT_LOOP_INTERVAL_S=5

# ---------------------------------------------------------------- capital
# The most money the bot will ever treat as its bankroll. Percentage limits
# below are computed on min(BANKROLL_USD, current conservative account value).
# NOTE: Polymarket orders usually need >= 5 shares (about $2.50 at a 50-cent price).
# With MAX_POSITION_PCT=0.01 a bankroll below ~$250-500 makes every position
# smaller than the exchange minimum, and the bot will (correctly) skip everything.
POLYBOT_BANKROLL_USD=500
# Starting cash for PAPER mode (simulated).
POLYBOT_PAPER_STARTING_BALANCE_USD=500

# ---------------------------------------------------------------- risk limits
# Max cost of any single new position: the SMALLER of these two.
POLYBOT_MAX_POSITION_USD=5
POLYBOT_MAX_POSITION_PCT=0.01
# Max total cost at risk on one event (e.g. one game, all its markets).
POLYBOT_MAX_EVENT_EXPOSURE_PCT=0.03
# Max total cost at risk across everything, open buy orders included.
POLYBOT_MAX_TOTAL_EXPOSURE_PCT=0.20
# Max at risk in one correlation group (same league + same UTC day).
POLYBOT_MAX_CORRELATED_EXPOSURE_PCT=0.06
# Stop opening positions when today's P&L (realized + conservative unrealized,
# deposits excluded) falls below -DAILY_LOSS_LIMIT_PCT * BANKROLL_USD. Manual reset needed.
POLYBOT_DAILY_LOSS_LIMIT_PCT=0.03
# Stop opening positions when trading equity falls this far below its high-water mark.
POLYBOT_MAX_DRAWDOWN_PCT=0.10
POLYBOT_MAX_OPEN_POSITIONS=10
# Cash that must stay untouched.
POLYBOT_MIN_CASH_RESERVE_USD=20
# Reject if best ask - best bid is wider than this (probability units, 0.04 = 4 cents).
POLYBOT_MAX_SPREAD=0.04
# Max price we will pay above the best ask when walking the book.
POLYBOT_MAX_SLIPPAGE=0.01
# Order book older than this (seconds) = stale -> no new entries.
POLYBOT_MAX_BOOK_AGE_S=30
# Probability estimate older than this (seconds) = stale -> no new entries.
POLYBOT_MAX_FAIR_AGE_S=900
# Never buy above / below these prices.
POLYBOT_MAX_ORDER_PRICE=0.90
POLYBOT_MIN_ORDER_PRICE=0.05
# No new entries this close to the scheduled start (pre-match strategy only).
POLYBOT_MIN_MINUTES_TO_START=30
# Ignore markets resolving further out than this.
POLYBOT_MAX_HOURS_TO_RESOLUTION=168
# Take at most this fraction of the displayed size at each price level.
POLYBOT_MAX_DEPTH_FRACTION=0.5
# Fraction of the Kelly stake (computed on a conservative probability). Caps above still apply.
POLYBOT_KELLY_FRACTION=0.10
# Max allowed difference between our clock and the exchange's (seconds).
POLYBOT_MAX_CLOCK_SKEW_S=2
# After this many consecutive order/API failures, pause new orders for the cooldown.
POLYBOT_CIRCUIT_BREAKER_FAILURES=5
POLYBOT_CIRCUIT_BREAKER_COOLDOWN_S=300

# ---------------------------------------------------------------- sports value strategy
POLYBOT_STRATEGY_SPORTS_VALUE_ENABLED=true
# Required edge = MIN_EDGE + max(MIN_UNCERTAINTY, UNCERTAINTY_Z * estimate std).
# Edge = independent probability - all-in cost per share (avg fill price + fee).
POLYBOT_MIN_EDGE=0.03
POLYBOT_UNCERTAINTY_Z=1.0
POLYBOT_MIN_UNCERTAINTY=0.01
# Need at least this many fresh bookmakers, agreeing within this std.
POLYBOT_MIN_BOOKMAKERS=3
POLYBOT_MAX_BOOKMAKER_DISAGREEMENT=0.04
# Margin removal: power (default), shin or multiplicative.
POLYBOT_DEVIG_METHOD=power
# Bookmakers weighted SHARP_WEIGHT times in the consensus.
POLYBOT_SHARP_BOOKMAKERS=pinnacle,betfair_ex_eu,matchbook
POLYBOT_SHARP_WEIGHT=3
# The Odds API regions and sport keys (see https://the-odds-api.com/sports-odds-data/sports-apis.html).
POLYBOT_ODDS_REGIONS=eu,uk
POLYBOT_SPORTS=soccer_epl,soccer_uefa_champs_league,americanfootball_nfl
# How often to poll odds. Each poll costs credits: (#sports x #regions) per poll.
POLYBOT_ODDS_POLL_INTERVAL_S=600
# Ignore a bookmaker whose line is older than this.
POLYBOT_ODDS_MAX_BOOKMAKER_UPDATE_AGE_S=1800
# Polymarket start time must be within this many minutes of the sportsbook's.
POLYBOT_MATCH_START_TOLERANCE_MIN=30
# Require the market's rules text to confirm the same settlement basis (90 min / incl. OT).
POLYBOT_REQUIRE_RESOLUTION_KEYWORDS=true
# Optional JSON {"alias": "canonical name"} to fix team-name mismatches.
POLYBOT_TEAM_ALIASES_PATH=
# In-play trading needs a reliable low-latency live-score feed; none is configured.
POLYBOT_LIVE_GAME_STRATEGY_ENABLED=false
# Research flag only. No momentum trading is implemented.
POLYBOT_MOMENTUM_ENABLED=false

# ---------------------------------------------------------------- exits
# Take profit when selling everything into current bids, after fees, returns
# at least this fraction more than the total cost (incl. entry fees).
POLYBOT_TAKE_PROFIT_PCT=0.06
# Exit when the fresh estimate no longer exceeds what selling now would pay.
POLYBOT_EXIT_ON_EDGE_LOSS=true
POLYBOT_EDGE_EXIT_MARGIN=0.0
# Optional trailing rule (on the same P&L % basis).
POLYBOT_TRAILING_ENABLED=false
POLYBOT_TRAILING_ACTIVATION_PCT=0.04
POLYBOT_TRAILING_DISTANCE_PCT=0.03
# 0 = no maximum holding period.
POLYBOT_MAX_HOLDING_HOURS=0
# Hold to resolution when no exit rule fires and the estimate still supports it.
POLYBOT_HOLD_TO_RESOLUTION=true
# 0 = disabled. A stop-loss is only a trigger: no guaranteed price, may not fill.
POLYBOT_STOP_LOSS_PCT=0
# Never sell below this price (no liquidation at any price).
POLYBOT_MIN_EXIT_PRICE=0.02
# What to do at game start: hold | exit_if_profitable | exit
POLYBOT_PRE_START_ACTION=hold
# Cancel the bot's resting entry orders this many minutes before start.
POLYBOT_CANCEL_ENTRIES_BEFORE_START_MIN=10

# ---------------------------------------------------------------- paper simulation
# Orders interact with the book only after this delay.
POLYBOT_PAPER_LATENCY_MS=750
# Assume only this fraction of displayed size is really available to us.
POLYBOT_PAPER_DEPTH_HAIRCUT=0.5
# Extra adverse ticks applied to simulated taker fills.
POLYBOT_PAPER_SLIPPAGE_TICKS=0
# Share of trade-through volume credited to resting (passive) orders.
POLYBOT_PAPER_PASSIVE_FILL_FRACTION=0.5

# ---------------------------------------------------------------- market data
POLYBOT_DISCOVERY_INTERVAL_S=300
POLYBOT_BOOK_POLL_INTERVAL_S=10
POLYBOT_USE_WEBSOCKET=true
POLYBOT_MIN_MARKET_LIQUIDITY_USD=500
POLYBOT_MAX_MARKETS_MONITORED=200

# ---------------------------------------------------------------- live trading (OFF)
# Must be true AND MODE=live AND the checklist complete for any real order.
POLYBOT_LIVE_TRADING_ENABLED=false
POLYBOT_LIVE_CHECKLIST_PATH=data/live_checklist.json
# Optional order heartbeat. WARNING: API-KEY-WIDE. Once started, if heartbeats
# stop for ~10 s the exchange tries to cancel ALL open orders of this API key,
# including ones you placed manually with the same key. Not guaranteed; never
# closes positions.
POLYBOT_USE_ORDER_HEARTBEAT=false
POLYBOT_GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYBOT_CLOB_URL=https://clob.polymarket.com
# Public wallet address is not secret, but keep it here or in the secrets file:
POLYBOT_POLYMARKET_WALLET_ADDRESS=
# SECRETS - leave blank here; use `polybot setup-credentials`:
POLYBOT_POLYMARKET_PRIVATE_KEY=
POLYBOT_POLYMARKET_API_KEY=
POLYBOT_POLYMARKET_API_SECRET=
POLYBOT_POLYMARKET_API_PASSPHRASE=

# ---------------------------------------------------------------- external data (secret)
POLYBOT_ODDS_API_KEY=
POLYBOT_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------- dashboard
# Keep 127.0.0.1 unless it sits behind TLS + authentication (docs/DEPLOYMENT.md).
POLYBOT_DASHBOARD_HOST=127.0.0.1
POLYBOT_DASHBOARD_PORT=8080
POLYBOT_DASHBOARD_USERNAME=admin
# Secret - set with `polybot setup-credentials`. Dashboard is disabled without it.
POLYBOT_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------- alerts (secrets)
# Telegram: create a bot with @BotFather, send it a message, get your chat id.
POLYBOT_TELEGRAM_BOT_TOKEN=
POLYBOT_TELEGRAM_CHAT_ID=
# Any webhook accepting JSON {"text": ...} (e.g. ntfy.sh topic URL, Slack incoming webhook).
POLYBOT_ALERT_WEBHOOK_URL=
# Repeat identical alerts at most this often (seconds).
POLYBOT_ALERT_COOLDOWN_S=600
